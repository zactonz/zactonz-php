<?xml version="1.0"?>
<ruleset name="zactonz-php">
    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
